{
  "name": "@clickstream/sdk",
  "version": "0.1.0",
  "description": "Browser SDK for ClickStream analytics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "terser": "^5.31.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.4",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "analytics",
    "clickstream",
    "product-analytics",
    "event-tracking",
    "browser-sdk"
  ]
}
