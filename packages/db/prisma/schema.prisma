generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String @map("password_hash")
  isVerified Boolean @default(false) @map("is_verified")
  createdAt DateTime @default(now()) @map("created_at")

  writeKeys WriteKey[]
  events Event[]
  refreshTokens RefreshToken[]

  @@map("organizations")
}

model Event {
  id String @id @default(uuid())
  eventId String @map("event_id")
  orgId String @map("org_id")
  anonId String @map("anon_id")
  sessionId String @map("session_id")
  userId String? @map("user_id")
  event String
  timestamp DateTime
  properties Json
  contentId String? @map("content_id")
  contentType String? @map("content_type")
  context Json
  pageUrl String? @map("page_url")
  pagePath String? @map("page_path")
  referrer String?
  browserName String? @map("browser_name")
  osName String? @map("os_name")
  deviceType String? @map("device_type")
  language String?
  timezone String? @map("timezone")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, eventId])
  @@index([orgId, timestamp])
  @@index([orgId, event])
  @@index([orgId, userId, timestamp])
  @@index([orgId, anonId, timestamp])
  @@index([orgId, sessionId, timestamp])
  @@index([orgId, browserName])
  @@index([orgId, osName])
  @@index([orgId, deviceType])
  @@map("events")
}

model WriteKey {
  id String @id @default(uuid())
  orgId String @map("org_id")
  keyHash String @unique @map("key_hash")
  label String
  allowedDomains String[] @map("allowed_domains")
  isActive Boolean @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("write_keys")
}

model RefreshToken {
  id String @id @default(cuid())
  orgId String @map("org_id")
  jti String @unique
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("refresh_tokens")
}